<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[Dreamine.PLC.Omron.Fins]*</Include>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**,**/Transport/TcpOmronFinsTransport.cs,**/Transport/UdpOmronFinsTransport.cs,**/Simulation/OmronFinsTcpSimulatorServer.cs,**/Simulation/OmronFinsUdpSimulatorServer.cs</ExcludeByFile>
          <UseSourceLink>false</UseSourceLink>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
